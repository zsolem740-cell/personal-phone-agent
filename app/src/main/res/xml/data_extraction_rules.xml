<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: az AI-kulcs se a felhős mentésbe, se az új telefonra átvitelbe nem kerül. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ai_config.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ai_config.xml" />
    </device-transfer>
</data-extraction-rules>
