<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ai_settings_provider"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/ai_provider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/ai_key"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/ai_key_hint"
        android:importantForAutofill="no"
        android:inputType="textPassword" />

    <EditText
        android:id="@+id/ai_model"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/ai_model_hint"
        android:importantForAutofill="no"
        android:inputType="text" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ai_key_note"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />
</LinearLayout>
