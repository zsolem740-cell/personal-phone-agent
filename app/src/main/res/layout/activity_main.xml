<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/app_background"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/header_bg"
            android:gravity="center_vertical"
            android:minHeight="60dp"
            android:orientation="horizontal"
            android:paddingLeft="17dp"
            android:paddingRight="17dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.12"
                android:text="@string/logo_title"
                android:textColor="@color/cyan"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:text="@string/status_online"
                android:textColor="@color/green_status"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/ai_settings_button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@null"
                android:contentDescription="@string/ai_settings_title"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_gear"
                android:tint="@color/text_muted" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include
                android:id="@+id/console_view"
                layout="@layout/view_console" />

            <include
                android:id="@+id/chat_view"
                layout="@layout/view_chat"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:background="@color/header_bg"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/nav_earth"
                style="@style/NavItem">

                <ImageView
                    android:id="@+id/nav_earth_icon"
                    style="@style/NavIcon"
                    android:src="@drawable/ic_globe" />

                <TextView
                    android:id="@+id/nav_earth_label"
                    style="@style/NavLabel"
                    android:text="@string/nav_earth" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_ai"
                style="@style/NavItem">

                <ImageView
                    android:id="@+id/nav_ai_icon"
                    style="@style/NavIcon"
                    android:src="@drawable/ic_brain" />

                <TextView
                    android:id="@+id/nav_ai_label"
                    style="@style/NavLabel"
                    android:text="@string/nav_ai" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_call"
                style="@style/NavItem">

                <ImageView
                    android:id="@+id/nav_call_icon"
                    style="@style/NavIcon"
                    android:src="@drawable/ic_phone" />

                <TextView
                    android:id="@+id/nav_call_label"
                    style="@style/NavLabel"
                    android:text="@string/nav_call" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_maps"
                style="@style/NavItem">

                <ImageView
                    android:id="@+id/nav_maps_icon"
                    style="@style/NavIcon"
                    android:src="@drawable/ic_map" />

                <TextView
                    android:id="@+id/nav_maps_label"
                    style="@style/NavLabel"
                    android:text="@string/nav_maps" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_sms"
                style="@style/NavItem">

                <ImageView
                    android:id="@+id/nav_sms_icon"
                    style="@style/NavIcon"
                    android:src="@drawable/ic_message" />

                <TextView
                    android:id="@+id/nav_sms_label"
                    style="@style/NavLabel"
                    android:text="@string/nav_sms" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/drawer_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6020710"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingLeft="25dp"
            android:paddingRight="25dp"
            android:paddingTop="55dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/drawer_panel"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageButton
                    android:id="@+id/drawer_close"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="right"
                    android:background="@null"
                    android:contentDescription="@string/drawer_close_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_delete"
                    android:tint="@color/text_muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/drawer_title"
                    android:textColor="@color/cyan"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/drawer_subtitle"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/drawer_ai_console"
                    style="@style/DrawerButton"
                    android:text="@string/drawer_ai_console" />

                <Button
                    android:id="@+id/drawer_notes"
                    style="@style/DrawerButton"
                    android:text="@string/drawer_notes" />

                <Button
                    android:id="@+id/drawer_reminders"
                    style="@style/DrawerButton"
                    android:text="@string/drawer_reminders" />

                <Button
                    android:id="@+id/drawer_phone_settings"
                    style="@style/DrawerButton"
                    android:text="@string/drawer_phone_settings" />

                <Button
                    android:id="@+id/drawer_ai_settings"
                    style="@style/DrawerButton"
                    android:text="@string/drawer_ai_settings" />

                <Button
                    android:id="@+id/drawer_solaris"
                    style="@style/DrawerButton"
                    android:text="@string/drawer_solaris" />

                <Button
                    android:id="@+id/drawer_diagnostics"
                    style="@style/DrawerButton"
                    android:text="@string/drawer_diagnostics" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/drawer_footnote"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</FrameLayout>
