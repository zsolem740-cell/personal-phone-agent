<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="14dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/panel_background"
        android:orientation="vertical"
        android:padding="13dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.1"
                android:text="@string/panel_chat_title"
                android:textColor="@color/cyan"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/chat_clear_button"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@null"
                android:contentDescription="@string/chat_clear_desc"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_delete"
                android:tint="@color/text_muted" />
        </LinearLayout>

        <ListView
            android:id="@+id/message_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:stackFromBottom="true"
            android:transcriptMode="alwaysScroll" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <EditText
            android:id="@+id/command_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/edittext_background"
            android:hint="@string/input_hint"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:maxLines="3"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted" />

        <ImageButton
            android:id="@+id/chat_mic_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/chip_background"
            android:contentDescription="@string/mic_button_desc"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mic"
            android:tint="@color/cyan" />

        <ImageButton
            android:id="@+id/speak_toggle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/chip_background"
            android:contentDescription="@string/speak_toggle_desc"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_speaker"
            android:tint="@color/cyan" />

        <Button
            android:id="@+id/send_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:background="@drawable/btn_send"
            android:text="@string/send"
            android:textColor="@android:color/white" />
    </LinearLayout>
</LinearLayout>
